<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SquadGUI.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SquadGUI.Views.SidePaneButtons">
    <Grid RowDefinitions="50,50,*,50">
        <Button Grid.Row="0"
                Classes="TitleBar"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Left"
                Height="50"
                Width="50"
                Command="{Binding TogglePaneCommand, RelativeSource={RelativeSource AncestorType=views:SidePaneButtons}}">
            ☰
        </Button>
        
        <Button Grid.Row="1" 
                Classes="TitleBar"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Left"
                Height="50"
                Width="50"
                Command="{Binding OpenFileCommand, RelativeSource={RelativeSource AncestorType=views:SidePaneButtons}}">
            <PathIcon Data="{DynamicResource NewFileIcon}"/>
        </Button>
        
        <Button Grid.Row="3" 
                Classes="TitleBar"
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Left"
                Height="50"
                Width="50">
            <PathIcon Data="{DynamicResource NewFileIcon}"/>
        </Button>
    </Grid>
</UserControl>
