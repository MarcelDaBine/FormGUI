<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SquadGUI.Views.CustomTitleBar"
             xmlns:vm="clr-namespace:SquadGUI.ViewModels"
             x:DataType="vm:DashboardViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Assets/MenuIcon.axaml"></StyleInclude>
    </UserControl.Styles>
    <Grid ColumnDefinitions="90*,5*,5*,5*">
        <Button Grid.Column="1" 
                Name="Minimize"
                Click="Minimize_OnClick"
                Height="35"
                Width="35">
            <PathIcon Data="{DynamicResource LineHorizontal1Regular}"/>
        </Button>
        <Button Grid.Column="2" 
                Name="Tabs"
                Click="Tabs_OnClick"
                Height="35"
                Width="35">
            <PathIcon Name="TabsIcon" Data="{DynamicResource TabsRegular}"/>
        </Button>
        <Button Grid.Column="3" 
                Name="Close"
                Click="Close_OnClick"
                Height="35"
                Width="35">
            <PathIcon Data="{DynamicResource CloseRegular}"></PathIcon>
        </Button>
    </Grid>
</UserControl>
