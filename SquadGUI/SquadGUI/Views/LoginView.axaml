<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SquadGUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SquadGUI.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:LoginViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="38*, 6*, 6*, 6*, 6* ,38*" ColumnDefinitions="*,*,*">
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="EmailBox"
                 MaxHeight="6" 
                 MinWidth="250" MaxWidth="300"
                 Margin="10"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Watermark="email"
                 KeyDown="EmailBox_OnKeyDown"
                 Text="{Binding Email}"/>
        
        <TextBox Grid.Row="2" Grid.Column="1"
                 x:Name="PassBox"
                 MaxHeight="6" 
                 MinWidth="250" MaxWidth="300"
                 Margin="10"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Watermark="password"
                 PasswordChar="*"
                 KeyDown="PassBox_OnKeyDown"
                 Text="{Binding Password}"/>
        
        <Button Grid.Row="3" Grid.Column="1"
                x:Name="SubmitButton"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="10"
                Command="{Binding LoginCommand}" >
            submit
        </Button>
        
        <TextBlock Grid.Row="4" Grid.Column="1"
               x:Name="ErrorBlock"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Text="{Binding ErrorText}">
        </TextBlock>
    </Grid>
</UserControl>