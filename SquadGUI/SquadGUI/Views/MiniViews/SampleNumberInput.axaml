<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SquadGUI.Views.SampleNumberInput"
             xmlns:vm="clr-namespace:SquadGUI.ViewModels"
             x:DataType="vm:DashboardViewModel">
    <UserControl.Styles>
        <StyleInclude Source="/Assets/Styles/TextBoxDashboardStyle.axaml"/>
    </UserControl.Styles>
    <Border
            BorderThickness="1"
            BorderBrush="DimGray">
        <Grid ColumnDefinitions="*,*,*,*,*" Height="32">
            <TextBlock Text="{Binding SampleReportNumber1}" 
                       Margin="7"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" 
                       Text="{Binding SampleReportNumberText}"
                       HorizontalAlignment="Center"
                       Margin="7"/>
            <TextBlock Grid.Column="2" 
                       Text="{Binding SelectedProjectile}"
                       HorizontalAlignment="Center"
                       Margin="7"
                       MaxWidth="300"/>
            <TextBlock Grid.Column="3"
                       HorizontalAlignment="Center"
                       Margin="7"
                       Text="{Binding SampleReportNumber2}"/>
            <TextBlock Grid.Column="4" 
                       Text="{Binding SelectedCondition}"
                       HorizontalAlignment="Center"
                       Margin="7"/>
        </Grid>
    </Border>
</UserControl>
