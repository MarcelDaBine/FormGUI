<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FormGUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FormGUI.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FormGUI.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="FormGUI"
        MinHeight="1080"
        MinWidth="1920"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        SystemDecorations="None"
        >
    <TransitioningContentControl Content="{Binding CurrentViewModel, DataType=vm:MainViewModel}">
        <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0.6"/>
        </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
</Window>